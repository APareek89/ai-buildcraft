# Copy this file to .env and fill in only what you need. .env is git-ignored: never commit real keys.
# Everything below is optional. The core notebooks (00a-08, 11-13) need no keys at all.

# Hugging Face: only for gated models or download rate limits. Read access is enough.
HF_TOKEN=

# Google Gemini: notebook 03 (synthetic data) and the optional RLAIF cell in notebook 09.
GEMINI_API_KEY=

# OpenAI: the optional API model rows in notebooks 10 and 12.
OPENAI_API_KEY=

# Use a base model stored outside models/ (for example a copy you already downloaded).
# PTL_BASE_MODEL_PATH=/absolute/path/to/Qwen2.5-0.5B-Instruct
