# ============================================================
# Claude Skills Toolkit — Environment Variables
# ============================================================
# Copy this file to .env and fill in your keys.
# Each skill only needs the keys relevant to it.
# ============================================================

# ── PostHog (Product Analytics & Performance Reporting) ──────
POSTHOG_API_KEY=phx_your_personal_api_key_here
POSTHOG_PROJECT_ID=12345
POSTHOG_HOST=https://us.posthog.com
# To get your API key: PostHog → Settings → Personal API Keys → Create

# ── Paddle (Revenue Skill) ───────────────────────────────────
PADDLE_API_KEY=pdl_live_apikey_your_key_here
PADDLE_ENVIRONMENT=live
# Options: "live" or "sandbox"
# Sandbox key (optional): pdl_sdbx_apikey_your_sandbox_key_here
PADDLE_SANDBOX_API_KEY=pdl_sdbx_apikey_your_sandbox_key_here
# To get your API key: Paddle → Developer Tools → Authentication → API Keys

# ── Google Search Console (SEO Skill) ────────────────────────
# GSC uses OAuth. Run the setup script to authenticate:
#   python3 skills/seo/scripts/gsc_auth.py
# After auth, tokens are stored at:
GSC_TOKEN_PATH=~/.claude-skills/gsc-tokens.json
GSC_PROPERTY=sc-domain:yourdomain.com
# Your verified GSC property (e.g., "sc-domain:example.com" or "https://example.com/")

# ── Google Analytics 4 (SEO / Performance Reporting) ─────────
GA4_PROPERTY_ID=123456789
# To find: GA4 → Admin → Property Settings → Property ID


# ── Slack Integration (all skills) ───────────────────────────
SLACK_ENABLED=false
# Set to "true" to enable Slack sharing for insights
# Skills will use the Slack MCP to send messages.
# Channels where insights should be posted:
SLACK_CHANNEL_INSIGHTS=#analytics-insights
SLACK_CHANNEL_ALERTS=#analytics-alerts
SLACK_CHANNEL_REPORTS=#weekly-reports
# You can override per-skill:
# SLACK_CHANNEL_SEO=#seo-updates
# SLACK_CHANNEL_REVENUE=#revenue-updates
# SLACK_CHANNEL_PRODUCT=#product-analytics
