# Local, no-key walkthrough. Never commit the copied .env.
MOCK_LLM=1
PORTFOLIO_AUTH_ENABLED=0
PUBLIC_BASE_URL=http://127.0.0.1:8877
STORAGE_BACKEND=local
CLOUD_SYNC=0

# To run real models, set MOCK_LLM=0, configure creator authentication below,
# and add your own API keys. Image generation/editing uses direct Gemini.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
ANTHROPIC_API_KEY=
RUNWARE_API_KEY=
SARVAM_API_KEY=
GCLOUD_TTS_API_KEY=
MODEL_TIER=eval
RUNTIME_PROVIDERS=gemini,claude,runware

# Required for real-provider mode: PostgreSQL and a strong random auth secret.
DATABASE_URL=
AUTH_SECRET=
DATABASE_SSL_CA_FILE=
# Local PostgreSQL only:
# PORTFOLIO_AUTH_ENABLED=1
# PORTFOLIO_ALLOW_INSECURE_LOCAL=1
# DATABASE_SSL=disable
