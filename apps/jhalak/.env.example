# Copy to .env.local. Requires Node 24+ and a local PostgreSQL database.
DATABASE_URL=postgresql://localhost:5432/jhalak
DATABASE_SSL=disable
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# Text/vision copy uses Anthropic; generated images/video use direct Gemini.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview
