# API provider configuration. Copy to .env only for an operator-managed live setup.
# The free local preview uses root .env.local generated by scripts/setup-local.py.
MOCK_LLM=1
MOCK_MEDIA=1
PLOTLINE_LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PLOTLINE_MEDIA_PROVIDER=gemini
GEMINI_API_KEY=
PLOTLINE_GEMINI_IMAGE_DRAFT=gemini-3.1-flash-image
PLOTLINE_GEMINI_IMAGE_FINAL=gemini-3.1-flash-image
PLOTLINE_GEMINI_IMAGE_PRO=gemini-3-pro-image-preview
PLOTLINE_GEMINI_VIDEO=veo-3.1-generate-preview
# Optional audio / explicitly selected fal media provider
FAL_KEY=
PLOTLINE_RAG_URL=http://127.0.0.1:8790
PLOTLINE_AUX_RAG_URL=http://127.0.0.1:8790
PLOTLINE_RAG_ENABLED=1
PLOTLINE_ALLOW_SEED_EVIDENCE=0
PLOTLINE_WEB_SEARCH=0
