# Ordinary PostgreSQL + Auth.js. Never use a legacy Supabase environment.
PUBLIC_ORIGIN=http://localhost:8986
AUTH_URL=http://localhost:8986
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://getcited_runtime:replace-password@127.0.0.1:55443/getcited_dev
DATABASE_NAME=getcited_dev
# Hosted deployments require a verified CA; disable is permitted only on loopback.
DATABASE_SSL=disable
DATABASE_SSL_CA_FILE=
# Generate exactly 32 random bytes encoded as base64 for opt-in stored BYOK.
KEY_ENCRYPTION_SECRET=
# Explicit keyless local fixture. Hosted ordinary service uses 0 and HTTPS.
GETCITED_MOCK_MODE=1
GETCITED_LOCAL_PREVIEW=1
GETCITED_BIND_HOST=127.0.0.1
GETCITED_DIST_DIR=.next-integrated
GETCITED_OWNER_BUDGET_USD=0.25
GETCITED_SHARED_BUDGET_USD=2
# Set only for ordinary live mode; leave all provider credentials unset locally.
OPENAI_API_KEY=
# Optional explicit BYOK providers are configured through the signed-in UI.
